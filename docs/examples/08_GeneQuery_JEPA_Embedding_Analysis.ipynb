      ],
      "text/plain": [
       "      time      n  cos_hat_tgt  cos_src_tgt  gap_hat_minus_copy\n",
       "0   6h_LPS  39185     0.964097     0.878208            0.085889\n",
       "1  10h_LPS  19713     0.963071     0.875765            0.087306\n",
