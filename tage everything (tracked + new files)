[32m+[m[32m      "source": [[m
[32m+[m[32m        "## 4.4. Quantitative embedding diagnostics\n",[m
[32m+[m[32m        "\n",[m
[32m+[m[32m        "These checks complement UMAP visuals with numbers:\n",[m
[32m+[m[32m        "- **Cell type separability** (5-fold linear probe accuracy)\n",[m
[32m+[m[32m        "- **Time separability** (5-fold linear probe accuracy)\n",[m
[32m+[m[32m        "- **Batch leakage** (5-fold linear probe accuracy; lower is usually better)\n",[m
[32m+[m[32m        "- **Silhouette score** by cell type (higher is better)\n",[m
[32m+[m[32m        "\n",[m
[32m+[m[32m        "Interpretation guideline:\n",[m
[32m+[m[32m        "- strong cell-type/time + weak batch = good biological embedding\n",[m
[32m+[m[32m        "- very strong batch signal may indicate technical leakage"[m
[32m+[m[32m      ][m
[32m+[m[32m    },[m
[32m+[m[32m    {[m
[32m+[m[32m      "cell_type": "code",[m
[32m+[m[32m      "execution_count": null,[m
[32m+[m[32m      "id": "274cd3ed",[m
[32m+[m[32m      "metadata": {},[m
[32m+[m[32m      "outputs": [],[m
[32m+[m[32m      "source": [[m
[32m+[m[32m        "X = adata_emb.X\n",[m
[32m+[m[32m        "\n",[m
[32m+[m[32m        "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",[m
[32m+[m[32m        "clf = make_pipeline(\n",[m
[32m+[m[32m        "    StandardScaler(),\n",[m
[32m+[m[32m        "    LogisticRegression(max_iter=2000, n_jobs=-1, multi_class=\"auto\"),\n",[m
[32m+[m[32m        ")\n",[m
[32m+[m[32m        "\n",[m
[32m+[m[32m        "def cv_acc(y):\n",[m
[32m+[m[32m        "    scores = cross_val_score(clf, X, y, cv=cv, scoring=\"accuracy\", n_jobs=-1)\n",[m
[32m+[m[32m        "    return float(scores.mean()), float(scores.std())\n",[m
[32m+[m[32m        "\n",[m
[32m+[m[32m        "ct_mean, ct_std = cv_acc(adata_emb.obs[\"cell_type_harmonized\"].values)\n",[m
[32m+[m[32m        "tp_mean, tp_std = cv_acc(adata_emb.obs[\"time_after_LPS\"].values)\n",[m
[32m+[m[32m        "bt_mean, bt_std = cv_acc(adata_emb.obs[\"batch\"].values)\n",[m
[32m+[m[32m        "\n",[m
[32m+[m[32m        "# Silhouette can be expensive; subsample if very large.\n",[m
[32m+[m[32m        "max_sil_cells = 10000\n",[m
[32m+[m[32m        "if adata_emb.n_obs > max_sil_cells:\n",[m
[32m+[m[32m        "    rng = np.random.default_rng(42)\n",[m
[32m+[m[32m        "    idx = rng.choice(adata_emb.n_obs, size=max_sil_cells, replace=False)\n",[m
[32m+[m[32m        "    X_sil = X[idx]\n",[m
[32m+[m[32m        "    y_sil = adata_emb.obs[\"cell_type_harmonized\"].values[idx]\n",[m
[32m+[m[32m        "else:\n",[m
[32m+[m[32m        "    X_sil = X\n",[m
[32m+[m[32m        "    y_sil = adata_emb.obs[\"cell_type_harmonized\"].values\n",[m
[32m+[m[32m        "\n",[m
[32m+[m[32m        "sil = silhouette_score(X_sil, y_sil, metric=\"cosine\")\n",[m
[32m+[m[32m        "\n",[m
[32m+[m[32m        "summary = pd.DataFrame(\n",[m
[32m+[m[32m        "    {\n",[m
[32m+[m[32m        "        \"metric\": [\n",[m
[32m+[m[32m        "            \"cell_type_cv_accuracy\",\n",[m
[32m+[m[32m        "            \"time_after_LPS_cv_accuracy\",\n",[m
[32m+[m[32m        "            \"batch_cv_accuracy\",\n",[m
[32m+[m[32m        "            \"cell_type_silhouette_cosine\",\n",[m
[32m+[m[32m        "        ],\n",[m
[32m+[m[32m        "        \"value\": [ct_mean, tp_mean, bt_mean, float(sil)],\n",[m
[32m+[m[32m        "        \"std\": [ct_std, tp_std, bt_std, np.nan],\n",[m
[32m+[m[32m        "    }\n",[m
[32m+[m[32m        ")\n",[m
[32m+[m[32m        "summary"[m
[32m+[m[32m      ][m
[32m+[m[32m    },[m
