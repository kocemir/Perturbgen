[31m-    "def _as_np(x):\n",[m
[31m-    "    if isinstance(x, torch.Tensor):\n",[m
[31m-    "        return x.detach().cpu().numpy()\n",[m
[31m-    "    return np.asarray(x)\n",[m
[31m-    "\n",[m
[31m-    "\n",[m
[31m-    "def encode_labels(y: np.ndarray) -> np.ndarray:\n",[m
[31m-    "    y = np.asarray(y).reshape(-1)\n",[m
[31m-    "    if y.dtype.kind in (\"U\", \"O\", \"S\"):\n",[m
[31m-    "        _, enc = np.unique(y.astype(str), return_inverse=True)\n",[m
[31m-    "        return enc\n",[m
[31m-    "    return y.astype(int) if np.issubdtype(y.dtype, np.integer) else y\n",[m
[31m-    "\n",[m
[31m-    "\n",[m
[31m-    "def load_jepa(path: Path) -> dict | None:\n",[m
[31m-    "    if not path.is_file():\n",[m
[31m-    "        print(f\"SKIP JEPA: missing {path}\")\n",[m
[31m-    "        return None\n",[m
[31m-    "    payload = torch.load(path, map_location=\"cpu\", weights_only=False)\n",[m
[31m-    "    out = {k: _as_np(v) for k, v in payload.items()}\n",[m
[31m-    "    for k in (\"z_src\", \"z_tgt\", \"z_hat\"):\n",[m
[31m-    "        if k in out:\n",[m
[31m-    "            print(f\"  {k}: {out[k].shape}\")\n",[m
[31m-    "    return out\n",[m
[31m-    "\n",[m
[31m-    "\n",[m
