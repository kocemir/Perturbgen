[31m-    "def reduce_2d(X: np.ndarray, seed: int = 0, max_n: int = 4000):\n",[m
[31m-    "    rng = np.random.default_rng(seed)\n",[m
[31m-    "    if len(X) > max_n:\n",[m
[31m-    "        idx = rng.choice(len(X), size=max_n, replace=False)\n",[m
[31m-    "        X = X[idx]\n",[m
[31m-    "    else:\n",[m
[31m-    "        idx = np.arange(len(X))\n",[m
[31m-    "    try:\n",[m
[31m-    "        import umap\n",[m
[31m-    "\n",[m
[31m-    "        coords = umap.UMAP(n_neighbors=30, min_dist=0.3, random_state=seed).fit_transform(X)\n",[m
[31m-    "        method = \"umap\"\n",[m
[31m-    "    except Exception as exc:  # noqa: BLE001\n",[m
[31m-    "        print(\"UMAP unavailable, PCA fallback:\", exc)\n",[m
[31m-    "        from sklearn.decomposition import PCA\n",[m
[31m-    "\n",[m
[31m-    "        coords = PCA(n_components=2, random_state=seed).fit_transform(X)\n",[m
[31m-    "        method = \"pca\"\n",[m
[31m-    "    return coords, idx, method\n",[m
[31m-    "\n",[m
[31m-    "\n",[m
[31m-    "def plot_space(emb, labels_dict, title, fname):\n",[m
