[31m-    "def pick_label(payload: dict, key: str) -> np.ndarray | None:\n",[m
[31m-    "    aliases = {\n",[m
[31m-    "        \"time\": [\"time\", \"time_after_LPS\"],\n",[m
[31m-    "        \"cell_type\": [\"cell_type_harmonized\", \"cell_type\"],\n",[m
