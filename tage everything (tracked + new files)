[31m-    "            }\n",[m
[31m-    "        )\n",[m
[31m-    "    return pd.DataFrame(rows)\n",[m
[31m-    "\n",[m
[31m-    "\n",[m
[31m-    "rows = []\n",[m
[31m-    "for model_name, jepa in jepa_models.items():\n",[m
[31m-    "    emb_j = jepa.get(\"z_tgt\", jepa.get(\"z_src\"))\n",[m
[31m-    "    jl = {k: v for k, v in {\n",[m
